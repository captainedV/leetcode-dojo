{
  "name": "leetcode-local-ide",
  "displayName": "LeetCode Dojo",
  "description": "在 VS Code / Cursor 里刷 LeetCode：左栏题面 + 右栏本地 IDE，本地编译调试、官方判题提交，并把 AI 补全限制在「API 提示 / 单行」级别。",
  "version": "0.4.3",
  "publisher": "xialc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "leetcode",
    "leetcode-cn",
    "local ide",
    "debug",
    "algorithm",
    "practice",
    "ai restraint",
    "cursor",
    "vs code"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lcLocal.enter",
        "title": "进入 LeetCode 模式",
        "category": "LeetCode Dojo",
        "icon": "$(browser)"
      },
      {
        "command": "lcLocal.exit",
        "title": "退出 LeetCode 模式",
        "category": "LeetCode Dojo",
        "icon": "$(close)"
      },
      {
        "command": "lcLocal.runLocal",
        "title": "本地运行测试",
        "category": "LeetCode Dojo",
        "icon": "$(debug-start)"
      },
      {
        "command": "lcLocal.debugLocal",
        "title": "本地调试",
        "category": "LeetCode Dojo",
        "icon": "$(bug)"
      },
      {
        "command": "lcLocal.runOnLeetCode",
        "title": "在 LeetCode 上运行（官方判题）",
        "category": "LeetCode Dojo",
        "icon": "$(play)"
      },
      {
        "command": "lcLocal.submit",
        "title": "提交到 LeetCode",
        "category": "LeetCode Dojo",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "lcLocal.switchLanguage",
        "title": "切换语言",
        "category": "LeetCode Dojo",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "lcLocal.reloadSnippet",
        "title": "重置为官方模板",
        "category": "LeetCode Dojo",
        "icon": "$(refresh)"
      },
      {
        "command": "lcLocal.regenerateHarness",
        "title": "重建本地测试脚手架",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.aiHarness",
        "title": "AI 生成测试脚手架（示例不足时）",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.aiHint",
        "title": "获取提示（不直接给答案）",
        "category": "LeetCode Dojo",
        "icon": "$(lightbulb)"
      },
      {
        "command": "lcLocal.setSession",
        "title": "设置登录 Cookie（leetcode.com 备用）",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.setAiKey",
        "title": "设置 AI API Key",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.toggleAiGuard",
        "title": "开启/关闭 AI 补全限制",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.showDiagnostics",
        "title": "显示诊断信息",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.openProblem",
        "title": "打开题目…",
        "category": "LeetCode Dojo",
        "icon": "$(search)"
      },
      {
        "command": "lcLocal.reloadPage",
        "title": "刷新网页",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.refreshSession",
        "title": "刷新登录状态",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.showLog",
        "title": "显示输出面板",
        "category": "LeetCode Dojo"
      },
      {
        "command": "lcLocal.signOut",
        "title": "退出登录（清除本地保存的登录态）",
        "category": "LeetCode Dojo",
        "icon": "$(sign-out)"
      },
      {
        "command": "lcLocal.openPanel",
        "title": "打开底部面板（测试用例 / 结果）",
        "category": "LeetCode Dojo",
        "icon": "$(layout-panel)"
      },
      {
        "command": "lcLocal.resetLayout",
        "title": "重置左右分栏布局（左题面 + 右代码）",
        "category": "LeetCode Dojo",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "lcLocal.quickMenu",
        "title": "打开快捷控制菜单",
        "category": "LeetCode Dojo",
        "icon": "$(flame)"
      }
    ],
    "keybindings": [
      {
        "command": "lcLocal.runLocal",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && lcLocal.active"
      },
      {
        "command": "lcLocal.submit",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && lcLocal.active"
      },
      {
        "command": "lcLocal.aiHint",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus && lcLocal.active"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lcLocal.runLocal",
          "when": "lcLocal.active",
          "group": "navigation@1"
        },
        {
          "command": "lcLocal.debugLocal",
          "when": "lcLocal.active",
          "group": "navigation@2"
        },
        {
          "command": "lcLocal.submit",
          "when": "lcLocal.active",
          "group": "navigation@3"
        },
        {
          "command": "lcLocal.openPanel",
          "when": "lcLocal.active",
          "group": "navigation@4"
        },
        {
          "command": "lcLocal.resetLayout",
          "when": "lcLocal.active",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "lcLocal.exit",
          "when": "lcLocal.active"
        }
      ]
    },
    "configuration": {
      "title": "LeetCode Dojo",
      "properties": {
        "lcLocal.site": {
          "type": "string",
          "enum": [
            "leetcode.cn",
            "leetcode.com"
          ],
          "default": "leetcode.cn",
          "markdownDescription": "使用哪个站点。`leetcode.cn` 可在 IDE 内完整内嵌网页并登录；`leetcode.com` 受 Cloudflare 限制，退化为 API 模式（需粘贴登录 Cookie）。"
        },
        "lcLocal.hint.level": {
          "type": "string",
          "enum": [
            "off",
            "signature",
            "line"
          ],
          "default": "signature",
          "description": "AI 辅助强度：off=完全关闭；signature=只提示当前所用 API 的函数签名/用法；line=允许补全当前这一行（不会补出整题解法）"
        },
        "lcLocal.hint.maxLineChars": {
          "type": "number",
          "default": 80,
          "description": "line 模式下单行补全的最大字符数"
        },
        "lcLocal.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用 AI 增强（行内受限补全、提示、测试脚手架生成）。需要配置 API Key。"
        },
        "lcLocal.ai.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "OpenAI 兼容接口的 baseUrl"
        },
        "lcLocal.ai.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "模型名称"
        },
        "lcLocal.ai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "API Key。保存在用户设置中；也可用环境变量 `LC_LOCAL_AI_KEY` 覆盖。"
        },
        "lcLocal.proxy.port": {
          "type": "number",
          "default": 0,
          "description": "内嵌网页代理端口，0 表示自动分配"
        },
        "lcLocal.proxy.injectBridge": {
          "type": "boolean",
          "default": true,
          "description": "向 LeetCode 页面注入桥接脚本（隐藏站点编辑器、接管运行/提交）。关闭后仅作为普通浏览器使用。"
        },
        "lcLocal.run.timeoutMs": {
          "type": "number",
          "default": 20000,
          "description": "单次本地测试的超时时间（毫秒）"
        },
        "lcLocal.run.debugPort": {
          "type": "number",
          "default": 5678,
          "description": "本地调试使用的调试端口"
        },
        "lcLocal.aiGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "进入 LeetCode 模式时限制其他 AI 补全插件（Copilot / Cursor Tab 设置项）在题目目录内生效"
        },
        "lcLocal.workspace.subdir": {
          "type": "string",
          "default": "leetcode",
          "description": "题目文件存放的子目录（相对于当前工作区根目录）"
        },
        "lcLocal.run.defaultLang": {
          "type": "string",
          "default": "python3",
          "description": "默认语言（进入题目时优先使用）"
        },
        "lcLocal.editor.hideSiteEditor": {
          "type": "boolean",
          "default": true,
          "description": "在题目页自动隐藏网页右侧代码区，仅保留题面铺满左栏（关闭后显示完整网页）"
        },
        "lcLocal.layout.autoSplit": {
          "type": "boolean",
          "default": true,
          "description": "进入 LeetCode 模式及打开题目时，自动将工作区划分为左右两栏（左栏题面网页，右栏本地代码）"
        },
        "lcLocal.layout.leftRatio": {
          "type": "number",
          "default": 0.45,
          "minimum": 0.25,
          "maximum": 0.7,
          "description": "自动左右分栏时左栏（题面网页）所占宽度比例（默认 0.45）"
        },
        "lcLocal.layout.lockLeftGroup": {
          "type": "boolean",
          "default": true,
          "description": "锁定左栏编辑器组，使文件树点击、搜索文件与断点调试跳转始终在右栏打开，避免遮挡左栏题面"
        },
        "lcLocal.python.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "指定本地 Python 解释器路径（例如 `/opt/homebrew/bin/python3.13`）。留空则自动挑选：优先 3.10+（LeetCode 模板里的 `ListNode | None` 需要它），同版本取最高。"
        },
        "lcLocal.judge.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "等待 LeetCode 判题结果的超时时间（毫秒）。超时后会自动复位「判题中」状态"
        },
        "lcLocal.aiGuard.aggressive": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "激进模式：除压制 Copilot/Cursor 的设置外，连 `editor.inlineSuggest.enabled` 一起关掉（彻底静音灰字补全；代价是本插件的 ghost text 也会停用，签名提示仍可用）"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "lcLocalPanel",
          "title": "LeetCode",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "lcLocalPanel": [
        {
          "id": "lcLocal.results",
          "name": "测试用例 / 结果",
          "type": "webview",
          "when": "lcLocal.active"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/captainedV/leetcode-dojo.git"
  },
  "bugs": {
    "url": "https://github.com/captainedV/leetcode-dojo/issues"
  },
  "homepage": "https://github.com/captainedV/leetcode-dojo#readme"
}
